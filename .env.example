# ==============================================================================
# Telegram Bridge Environment Variables
# ==============================================================================

# Token lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Danh sách ID người dùng Telegram được phép điều khiển (ngăn cách bằng dấu phẩy)
# Lấy ID của bạn thông qua bot @userinfobot
ALLOWED_TELEGRAM_USER_IDS="12345678,87654321"

# Thiết lập giới hạn tần suất lệnh (Rate Limiting)
RATE_LIMIT_MAX_CALLS=15
RATE_LIMIT_PERIOD_SEC=60

# Tự động phát hiện agent bị Blocked và gửi thông báo phê duyệt lên Telegram
AUTO_NOTIFY_BLOCKED=true
POLL_INTERVAL_SEC=3

# Danh sách Chat ID nhận thông báo tự động (mặc định gửi tới ALLOWED_TELEGRAM_USER_IDS)
# NOTIFICATION_CHAT_IDS="12345678,87654321"

# Đường dẫn Socket tùy biến của Herdr (để trống để dùng mặc định)
# HERDR_SOCKET_PATH="/home/user/.config/herdr/herdr.sock"
