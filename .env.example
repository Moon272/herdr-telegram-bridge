# Required: BotFather token and allowed positive Telegram user IDs.
TELEGRAM_BOT_TOKEN=""
ALLOWED_TELEGRAM_USER_IDS=""

# Optional extra notification chats, ADDED to the allowed users above.
# Group IDs may be negative. Receiving notifications does not grant control.
# NOTIFICATION_CHAT_IDS="-123456789"

# Default: resolve herdr from PATH. Use a full path when running in background.
# HERDR_EXECUTABLE="C:/Users/you/.herdr/path/to/herdr.exe"
HERDR_COMMAND_TIMEOUT_SEC=15
# HERDR_SOCKET_PATH="..."

RATE_LIMIT_MAX_CALLS=15
RATE_LIMIT_PERIOD_SEC=60
AUTO_NOTIFY_BLOCKED=true
AUTO_NOTIFY_IDLE=true
POLL_INTERVAL_SEC=3

TELEGRAM_CONNECT_TIMEOUT=30
TELEGRAM_READ_TIMEOUT=30
TELEGRAM_WRITE_TIMEOUT=30
TELEGRAM_POOL_TIMEOUT=15
# TELEGRAM_PROXY="http://127.0.0.1:7890"
